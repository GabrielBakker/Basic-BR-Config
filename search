01300 def FNVALID(FILENAME$*8)
01305    fnvalid=1 !assume valid
01310    for i = 1 to len(filename$)
01320       if (ord(filename$(i:i))>64 and ord(filename$(i:i))<91) or (ord(filename$(i:i))>96 and ord(filename$(i:i))<123) or (ord(filename$(i:i))=95) then !:
               ! good !:
            else !:
               fnvalid=0
01330    next i
01340 fnend
01500 Ignore: Continue

01700 def fnAscii(&string$;___,Char,Index)
01710    let fnAscii=1
01720    for index=1 to len(string$)
01730       let Char=ord(string$(index:index))
01740       if (Char<32 and Char><10 and Char><13 and Char><26) or Char>=127 then let fnAscii=0 : goto DonefnAscii
01750    next index
01760 DonefnAscii: fnend

