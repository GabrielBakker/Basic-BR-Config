00001 ! ===== BLESSED EXEMPLAR (context/app/exemplars) =====
00002 ! Archetype: report, driven through a ScreenIO screen (date-range prompt) rather than a
00003 ! bare batch program. Its "print the report" logic is one imported function
00004 ! (fnPrintProfitAndLoss, see function_printprofitandloss.brs in this folder), which itself
00005 ! delegates the real work to library "report" : fnProfitAndLoss.
00006 ! Note: GENERATED file — do not hand-edit; see screenio_airlinesedit.brs's header for why.
00007 ! =====================================================
00010 ! screenio\reportpl.br
00020 ! ScreenIO Generated Helper Library for REPORTPL screen
00030 ! Copyright 2008 by Sage AX
00040 !
00050 ! Compiled On: 04/02/2023
00060 ! Version: 6
00070 !
00080 !
00090 !
00300 !
00310    option retain
00320    dim FileIOLinkageSet
00330    dim Ret$*255
00340    dim PassedData$(1)*255
00350    mat PassedData$(0)
00600 !
01000 Main: ! If you run me as a program, I run the reportpl screen
01010    library "screenio" : fnfm$
01020    let Ret$=fnfm$("reportpl","",0,0,"",0,0,0,0,mat PassedData$)
01030    if len(trim$(Ret$)) then
01040       print Ret$
01050    end if
01060    if fkey=93 then execute "system"
01070    stop
01080 !
05000 CustomFunctions: ! Lines 5000 - 70000 are Custom Functions
05001 ! ============================================================
05002 ! Imported From "function\printprofitandloss.brs"
05003 ! function\printprofitandloss.brs
05004 ! Created on 04/28/2009
05005 !
05006 ! fnPrintProfitAndLoss - This Function Prints the Profit and Loss Report
05007 !
05008 !
05009 def fnPrintProfitAndLoss(mat s$,&ExitMode;___,StartDate,EndDate,StatusWindow)
05010    library "report" : fnProfitAndLoss
05011 !
05012    let StartDate=val(s$(sio_startdate))
05013    let EndDate=val(s$(sio_enddate))
05014 !
05015    if StartDate and EndDate then
05016       open #(StatusWindow:=fnGetFileNumber): "srow=14,scol=31,rows=1,cols=20,BORDER=S",display,outin
05017       print #StatusWindow, fields "1,1,CC 20" : "Now Printing..."
05018       let fnProfitAndLoss(StartDate,EndDate)
05019       close #StatusWindow:
05020 !
05021       let ExitMode=QuitOnly
05022    else
05023       let msgbox("Please enter two Valid Dates. If you did enter valid dates and I didn't recognise them, I'm sorry. Try entering the date in the format mm/dd/ccyy. I'm a little daft sometimes. I am only a machine, after all.","Date Error")
05024    end if
05025 fnend
05026 !
05027 ! Imported From "function\initializereport.brs"
05028 ! function\initializereport.brs
05029 ! Created on 04/28/2009
05030 !
05031 ! fnInitializeReport - This Function Initializes default values in SageLive
05032 !  report dialogs.
05033 !
05034 !
05035 def fnInitializeReport(mat s$;___,EndDay,StartDate,EndDate,year)
05036 !
05037    let endDay=31
05038    do while ~days(date$("yy/mm")&"/"&str$(endday))
05039       let endDay-=1
05040    loop until endDay=27
05041 !
05042    let Year=val(date$("ccyy"))
05043    if uprc$(trim$(ScreenIO$(si_screencode)))="REPORTPL" then
05044       if val(date$("mm"))<6 then
05045          let StartDate=days("01/01/"&str$(year-1),"mmddccyy")
05046          let EndDate=days("12/31/"&str$(year-1),"mmddccyy")
05047       else
05048          let StartDate=days("01/01/"&str$(year),"mmddccyy")
05049          let EndDate=days("12/31/"&str$(year),"mmddccyy")
05050       end if
05051    else
05052  ! .  ! Run for all time by default. After all its called the "Complete and Speculative Customer History Report".
05053       let StartDate=days(date$("mm")&"/01/2005","mm/dd/ccyy")
05054       let EndDate=days(date$("mm")&"/"&str$(EndDay)&"/"&date$("ccyy"),"mm/dd/ccyy")
05055    end if
05056 !
05057    if sio_startdate then let s$(sio_startdate)=str$(StartDate)
05058    if sio_enddate then let s$(sio_enddate)=str$(EndDate)
05059    if sio_reportdate then let s$(sio_reportdate)=str$(days(date$("mm/dd/ccyy"),"mm/dd/ccyy"))
05060 !
05061    if sio_customer then
05062       let CustomerCode$=ParentKey$
05063       let s$(sio_customer)=fnReadUnopenedDescription$("customer",CustomerCode$)
05064    end if
05065 !
05066 fnend
05067 !
05068 !
05069 !
85000    def library fnCheckStringFunction(Function$*255)
85001    if Function$ = "{printprofitandloss}" then
85002       let fnCheckStringFunction = 0
85003       else if Function$ = "{initializereport}" then
85004          let fnCheckStringFunction = 0
85005       else
85006          if Function$<>"{{GetData}}" and Function$<>"{{SetData}}" then
85007             print "Function ("&function$&") on screen REPORTPL is not Supported: The library is out of date or fn not found."
85008          end if
85009       end if
85010    fnend
